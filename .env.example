# =========================================================================
# MEntee Environment Variables Template
# Add these in Vercel -> Project Settings -> Environment Variables
# =========================================================================

# Production MongoDB Atlas Cloud Database URI (Required for Vercel)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mentee_db?retryWrites=true&w=majority

# Secure Random JWT Secret Key (Required for production authentication)
JWT_SECRET=super_secret_jwt_random_key_replace_this_for_production_2026

# Environment Flag
NODE_ENV=production

# Frontend URL (Optional: Vercel automatically routes same-domain /api, but set if deploying separately)
CLIENT_URL=https://your-app-name.vercel.app

# Cloudinary Cloud Storage Configuration (Optional: Recommended for persistent file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
