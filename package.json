{
  "name": "mentee-system-root",
  "version": "1.0.0",
  "description": "Full-Stack Mentor-Mentee Management System (MEntee)",
  "type": "module",
  "scripts": {
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "start": "node server/server.js",
    "db:seed": "node server/seed.js",
    "db:migrate": "node server/migrate-local-to-atlas.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
